{
  "cardinal": {
    "type": "http",
    "url": "${CARDINAL_MCP_URL}",
    "headers": {
      "X-CardinalHQ-API-Key": "${CARDINAL_MCP_API_KEY:-}"
    }
  },
  "cardinal-behavior": {
    "type": "stdio",
    "command": "python3",
    "args": [
      "${CLAUDE_PLUGIN_ROOT}/bin/cardinal-behavior"
    ]
  }
}
