#!/usr/bin/env python3
"""cardinal-disconnect — remove the Cardinal plugin's config from this install.

What gets removed:
  - The OTel env keys this plugin owns from ~/.claude/settings.json
    (any non-plugin env entries are left untouched).
  - The `cardinal` MCP entry from ~/.claude.json (if present).
  - ~/.claude/cardinal.json (state file).

What gets revoked server-side (best effort):
  - The MCP API key, via POST <host>/api/maestro-keys/<mcp_key_id>/revoke.
    The plugin holds the plaintext so it authenticates as the key itself
    (R11 §1 "self" path).
  - The ingest key is NOT revoked here yet — the corresponding maestro
    endpoint hasn't shipped. The script prints a note pointing at the
    admin UI for now.
"""

import argparse
import json
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path


CLAUDE_DIR = Path.home() / ".claude"
SETTINGS_PATH = CLAUDE_DIR / "settings.json"
STATE_PATH = CLAUDE_DIR / "cardinal.json"
CLAUDE_JSON_PATH = Path.home() / ".claude.json"

OWNED_ENV_KEYS = {
    "CLAUDE_CODE_ENABLE_TELEMETRY",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA",
    "OTEL_METRICS_EXPORTER",
    "OTEL_LOGS_EXPORTER",
    "OTEL_TRACES_EXPORTER",
    "OTEL_EXPORTER_OTLP_PROTOCOL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_RESOURCE_ATTRIBUTES",
    "OTEL_LOG_TOOL_DETAILS",
}


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    ts = time.strftime("%Y%m%d-%H%M%S")
    bk = path.with_suffix(f"{path.suffix}.bak.{ts}")
    bk.write_text(path.read_text())
    return bk


def revoke_mcp_key(host: str, key_id: str, plaintext: str | None) -> tuple[bool, str]:
    """Best-effort POST /api/maestro-keys/<id>/revoke. Authenticates with the
    plaintext key if we still have it (R11 §1 "self" path); without it the
    server will return 403 and we surface that for the user to revoke via
    the admin UI."""
    url = host.rstrip("/") + f"/api/maestro-keys/{key_id}/revoke"
    headers = {"content-type": "application/json"}
    if plaintext:
        headers["X-CardinalHQ-API-Key"] = plaintext
    req = urllib.request.Request(url, data=b"", method="POST", headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.status in (200, 204), f"HTTP {resp.status}"
    except urllib.error.HTTPError as e:
        return False, f"HTTP {e.code}"
    except (urllib.error.URLError, TimeoutError) as e:
        return False, f"network error: {e}"


def remove_owned_env(settings_path: Path) -> int:
    """Strip OWNED_ENV_KEYS from settings.json's env. Returns the number of
    keys removed. Refuses on malformed JSON."""
    if not settings_path.exists():
        return 0
    try:
        settings = json.loads(settings_path.read_text())
    except Exception as e:
        sys.exit(f"refusing to modify: {settings_path} is malformed ({e})")
    env = settings.get("env", {})
    if not isinstance(env, dict):
        return 0
    before = len(env)
    for key in OWNED_ENV_KEYS:
        env.pop(key, None)
    after = len(env)
    if not env:
        settings.pop("env", None)
    else:
        settings["env"] = env
    settings_path.write_text(json.dumps(settings, indent=2) + "\n")
    return before - after


def remove_mcp_entry(claude_json_path: Path) -> bool:
    """Remove the `cardinal` entry from ~/.claude.json's mcpServers. Returns
    True iff an entry was present. Refuses on malformed JSON."""
    if not claude_json_path.exists():
        return False
    try:
        data = json.loads(claude_json_path.read_text())
    except Exception as e:
        sys.exit(f"refusing to modify: {claude_json_path} is malformed ({e})")
    servers = data.get("mcpServers")
    if not isinstance(servers, dict) or "cardinal" not in servers:
        return False
    servers.pop("cardinal", None)
    if not servers:
        data.pop("mcpServers", None)
    else:
        data["mcpServers"] = servers
    claude_json_path.write_text(json.dumps(data, indent=2) + "\n")
    return True


def main() -> int:
    p = argparse.ArgumentParser(prog="cardinal-disconnect")
    p.add_argument("--force", action="store_true",
                   help="Don't fail if the state file is missing.")
    p.add_argument("--keep-telemetry", action="store_true",
                   help="Remove only the MCP side; leave the OTel env block "
                        "and ~/.claude/cardinal.json's telemetry section in "
                        "place. Useful for going from telemetry-and-mcp back "
                        "to telemetry-only without re-running /cardinal:connect.")
    args = p.parse_args()

    if not STATE_PATH.exists() and not args.force:
        print("Cardinal is not connected. Nothing to do.")
        return 0

    state: dict = {}
    if STATE_PATH.exists():
        try:
            state = json.loads(STATE_PATH.read_text())
        except Exception as e:
            sys.exit(f"refusing to proceed: {STATE_PATH} is malformed ({e})")

    host = state.get("host") or "https://app.cardinalhq.io"
    mcp_key_id = state.get("mcp_key_id")
    ingest_key_id = state.get("ingest_key_id")

    # ---- Revoke MCP key server-side (best effort) ------------------------
    if mcp_key_id:
        plaintext = _extract_mcp_plaintext_from_claude_json()
        ok, msg = revoke_mcp_key(host, mcp_key_id, plaintext)
        if ok:
            print(f"  ✓ Revoked MCP key {state.get('mcp_key_prefix') or mcp_key_id} server-side ({msg})")
        else:
            print(f"  ⚠ Could not revoke MCP key server-side ({msg}).")
            print(f"    Visit {host}/settings/api-keys to revoke it manually.")

    # ---- Remove MCP entry from ~/.claude.json ----------------------------
    if CLAUDE_JSON_PATH.exists():
        bk = backup(CLAUDE_JSON_PATH)
        if remove_mcp_entry(CLAUDE_JSON_PATH):
            print(f"  ✓ Removed `cardinal` MCP entry from {CLAUDE_JSON_PATH}")
            if bk:
                print(f"    Backup → {bk}")

    # ---- Remove OTel env keys + state file -------------------------------
    if not args.keep_telemetry:
        if SETTINGS_PATH.exists():
            bk = backup(SETTINGS_PATH)
            removed = remove_owned_env(SETTINGS_PATH)
            if removed:
                print(f"  ✓ Removed {removed} OTel env key(s) from {SETTINGS_PATH}")
                if bk:
                    print(f"    Backup → {bk}")
        if STATE_PATH.exists():
            STATE_PATH.unlink()
            print(f"  ✓ Removed {STATE_PATH}")

        if ingest_key_id:
            print()
            print("  Note: the ingest API key is still active server-side. The")
            print("        device-code-issued ingest revoke endpoint hasn't shipped")
            print(f"        yet; revoke it via {host}/settings/api-keys when you can.")
    else:
        # keep-telemetry path: rewrite state so mode flips back to telemetry-only.
        if state:
            state["mode"] = "telemetry-only"
            for k in ("mcp_url", "mcp_key_id", "mcp_key_prefix", "mcp_created_at"):
                state.pop(k, None)
            STATE_PATH.write_text(json.dumps(state, indent=2) + "\n")
            print(f"  ✓ Updated {STATE_PATH} → mode=telemetry-only")

    print()
    print("✓ Local config updated. Restart Claude Code so it picks up the change.")
    return 0


def _extract_mcp_plaintext_from_claude_json() -> str | None:
    """The plugin doesn't persist the MCP plaintext to ~/.claude/cardinal.json
    (would be a step backwards for secret hygiene). But it IS in
    ~/.claude.json under mcpServers.cardinal.headers — that's the only
    place we can fish it out from now. If the entry is gone the self-revoke
    path 403s and the user gets the admin-UI fallback message."""
    if not CLAUDE_JSON_PATH.exists():
        return None
    try:
        data = json.loads(CLAUDE_JSON_PATH.read_text())
    except Exception:
        return None
    entry = (data.get("mcpServers") or {}).get("cardinal")
    if not isinstance(entry, dict):
        return None
    headers = entry.get("headers")
    if not isinstance(headers, dict):
        return None
    val = headers.get("X-CardinalHQ-API-Key")
    return val if isinstance(val, str) else None


if __name__ == "__main__":
    sys.exit(main())
