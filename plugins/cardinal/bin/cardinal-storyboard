#!/usr/bin/env python3
"""cardinal-storyboard — local facts for Cardinal Investigation Storyboards.

Commands:
  context [--cwd DIR] [--session-id ID]
      Print {"context": {...}} on one line: where this storyboard is being
      written, for storyboard__find, storyboard__create and
      storyboard__add_act to take as `context`. Fields (each only when
      known): repo (origin, lowercased "org/name"), repo_path (relative to
      the repo root, "." at the root), branch (not main, master, develop or
      trunk), pr_number and pr_url (the branch's PR, from `gh`, cached),
      head_sha, workdir_hash (a hash of this machine and directory), client
      ("claude-code/<plugin version>"), actor_email (the user.email Cardinal
      telemetry is tagged with, from ~/.claude/settings.json; never git
      config), paths (the repo-relative files this session edited in this
      repo, with --session-id or $CLAUDE_CODE_SESSION_ID). Never an
      absolute path. The storyboard-context hook stamps the same object
      automatically; this is the fallback. Always exits 0: on any failure it prints what it
      could collect, at worst {"context": {}}.

  discover [--cwd DIR] [--json]
      Print the block the storyboard-discovery hook injects at session
      start: the storyboards of this PR, branch or directory (not the whole
      repo), at most 3 and 2 KB, framed as data written by org members.
      Nothing (or {"block": null} with --json) when not connected, outside a
      repo, or when nothing matches. For other harnesses and for debugging:
      no session cache, ignores CARDINAL_STORYBOARD_DISCOVERY. Always exits
      0; the network part has a hard 2 s deadline.

  Every connected Claude Code session already has an Investigation and its
  live Storyboard: the SessionStart hook creates (or, on resume, reuses)
  them and binds the session (~/.cardinal/investigations/sessions/<SID>.json).
  Nobody needs to create, bind or start anything; the commands below read
  that binding or are for explicit, optional use.

  investigation link [--session SID] [--json]
      Print this session's private live Storyboard URL and its
      Investigation URL (and ids), from the binding: no network. Missing
      (the session-start request failed, or an older binding): asks Cardinal
      now (ensure-session-investigation, idempotent) and records the answer.
      This is the answer to "what's the storyboard link?".

  investigation question TEXT [--session SID | --investigation ID]
      Record what the investigation asks (set-investigation-question, 1 to
      1000 characters): the user's question as you understood it, once they
      have said it. Your statement, not owner authority; the server records
      who set it (and this session, as a claim). Only the investigation's
      author can. The investigation keeps its id; renaming never creates
      another.

  investigation create --question TEXT [--window JSON]
      Optional: create a separate Investigation on Cardinal (authored by
      this key's user) and print its id (inv_...), binding this session
      ($CLAUDE_CODE_SESSION_ID) to it instead of its automatic one. Its
      InvestigationState can be published before any storyboard exists:
      state init --investigation.

  investigation attach <investigation_id> <storyboard_id>
      Attach a storyboard (one you authored an act of) to your
      investigation; one storyboard per investigation. Then state init
      --investigation ID --refresh re-projects the state from it, keeping
      everything authored.

  investigation show <investigation_id>
      Print the investigation: question, window, author, storyboard, and
      its state's version.

  investigation bind <investigation_id> [--session SID]
      Optional: bind an agent session (default $CLAUDE_CODE_SESSION_ID) to
      another existing investigation (as CARDINAL_INVESTIGATION_ID=inv_...
      at launch does): its advisory events (cue / question / challenge from
      other principals) then reach the session at its tool boundaries.

  investigation ack <investigation_id> <seq> --disposition accepted|declined|noted [--note TEXT] [--session SID]
      Acknowledge advisory event #seq as this session (idempotent per
      session and event). Only the investigation's author can.

  investigation events <investigation_id> [--after N] [--json]
      Print the investigation's event stream after seq N (default 0):
      control events and semantic checkpoints, in seq order.

  investigation checkpoint [--session SID] [--key K] [--json]  (events on stdin)
      Record that this session's understanding materially changed: a
      hypothesis it starts relying on or resolves, an experiment it starts
      or finishes, a finding it proposes / revises / retracts, a decision
      it proposes / revises, a material question it opens / resolves. A
      JSON array of 1-20 events on stdin, appended to the session's
      Investigation as one atomic batch (checkpoint-investigation). Each is
      the session's claim, never a fact or owner authority, and never
      InvestigationState; conclusions only, never reasoning or routine
      tool use. Only the investigation's author session can. Cited ev_ ids
      are uploaded first as receipts of the Investigation (only those;
      upload-investigation-evidence, never through a storyboard, so a
      published storyboard does not matter); rcpt_ ids pass as they are.
      Ids get their family's prefix (fnd_x -> finding_x, a bare id -> its
      family's). The default key is derived from the events as cited, so
      a retry is deduplicated. `--help` lists the types.

  investigation post <investigation_id> --type cue|question|challenge --text TEXT
                     [--to-session SID] [--idempotency-key KEY]
      Append an advisory event (a producer's convenience; any org principal
      with storyboard write access). Advisory only: it never carries owner
      authority.

  state init (<storyboard_id> | --investigation ID) [--out PATH] [--refresh | --force]
      Write the InvestigationState of a published storyboard: the
      machine-readable twin of the storyboard for an agent continuing the
      investigation without the transcript (cardinal_core.investigation_state).
      Its derived half (question, findings, ruled-out hypotheses, open
      questions, evidence tiers) is projected from storyboard__get; its
      authored sections (actors, constraints with their exceptions,
      decisions with who proposed / decided them, hypothesis basis, what each
      receipt is, resolution links, pending asks, typed refs, status,
      re-typed open questions) start empty for the author to fill. Default
      PATH: ~/.claude/cardinal/investigation-state/<storyboard_id>.json.
      An existing file: --refresh re-projects it (after a new act) and
      keeps everything authored; --force starts over. With --investigation
      the state belongs to the investigation (PATH.server records it):
      projected from its storyboard if one is attached, else from nothing
      (question and window are the investigation's; the derived half is
      empty; status open). Default PATH: .../investigation-state/<id>.json.

  state check <PATH>
      Re-project from the server and check the document: derived fields
      unedited, every open question kept or re-typed under its id, every
      reference resolving to an item or a cited receipt, every decision
      saying why and, when an owner decided it, where they did; no field
      the schema does not know. Prints errors, warnings and its size; exit
      1 on errors. --downgrade first lowers every authority claim its
      sources do not establish, keeping the content. An item of the last
      state that checked ok (PATH.last-ok) may not disappear unless named
      in --allow-remove: validation lowers authority, it never erases.

  state publish <PATH> [--allow-remove ID]
      Check the document as `state check` does, then publish it to Cardinal
      as the storyboard's InvestigationState (put-state). The server runs
      the same checks again and refuses an invalid state. It cannot read
      session transcripts, so this client attests the quotes and plan
      approvals it verified against them (cardinal_core.
      investigation_state_sync); the server returns every authority claim
      resting on them marked client-attested, never verified. Only an
      author of one of the storyboard's acts (of an investigation-bound
      state: the investigation's author) may publish. After a publish
      the SERVER copy is canonical: PATH.server records its version and
      etag, the next publish is based on that version, and a publish based
      on an older one is refused (run `state pull` and re-apply the edits).

  state pull (<storyboard_id> | --investigation ID) [--out PATH] [--force]
      Fetch the server copy (get-state) into PATH (default as for init),
      with PATH.server and PATH.last-ok. Refuses to overwrite a PATH whose
      content differs from the server copy unless --force.

  check and publish find what a state belongs to in PATH.server: an
  investigation (written by init / pull / publish with --investigation)
  or, without one, the storyboard in its source (as in plugin 0.40.0).

  init and check take --from-get FILE (a saved storyboard__get result) instead of
  fetching. Owner and agent quotes are verified against the session
  transcript of every published act found under ~/.claude/projects (the
  transcript is read as an oracle, never copied) and, for an
  investigation-bound state, of the session the investigation was created
  in (never the session that happens to run this command); --session FILE
  adds one. An investigation created outside a session has no oracle:
  nothing in its state rests on a quote unless --session names one.

The storyboard skill authors this session's live storyboard (its id is in
the session-start context and in `investigation link`). To add to another
storyboard it runs `context` and passes the object to storyboard__find, then
follows the rule find returns. The fields are labels for finding a
storyboard, never authorization.

Core logic lives in the vendored cardinal_core.storyboard_context (shared by
every adapter); this launcher supplies Claude Code's client, actor email and
PR cache.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT / "hooks"))

EXIT_USAGE = 2


def plugin_client() -> str:
    """claude-code/<plugin version>, the same `client` captured receipts carry."""
    try:
        from cardinal_core import evidence
        from _plugin_version import plugin_version
        return evidence.client_string("claude-code", plugin_version())
    except Exception:
        return "claude-code"


def actor_email():
    """user.email from the OTel resource attributes cardinal-connect wrote
    into ~/.claude/settings.json (or the environment). Never git config."""
    try:
        import _otel_settings
        return _otel_settings.resource_attrs(_otel_settings.load_otel_settings()).get("user.email")
    except Exception:
        return None


def pr_resolver():
    try:
        from cardinal_core import decisions, storyboard_context
        from cardinal_core.paths import AgentPaths
        runtime = AgentPaths(home=Path(os.environ.get("HOME") or str(Path.home())) / ".claude").runtime_dir
        return storyboard_context.default_pr_resolver(decisions.cache_dir(runtime))
    except Exception:
        return None


def edited_paths(session_id):
    """storyboard_files.for_repo for this session, or None without one."""
    sid = session_id or os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_SESSION_ID")
    if not sid:
        return None
    try:
        from cardinal_core import storyboard_files
        import _storyboard_discovery
        files = _storyboard_discovery.files_dir()
        return lambda repo: storyboard_files.for_repo(files, sid, repo)
    except Exception:
        return None


def cmd_context(args: argparse.Namespace) -> int:
    context: dict = {}
    try:
        from cardinal_core import storyboard_context
        context = storyboard_context.collect(
            args.cwd or os.getcwd(),
            client=plugin_client(),
            actor_email=actor_email(),
            pr_resolver=pr_resolver(),
            edited_paths=edited_paths(args.session_id),
        )
    except Exception:
        context = {}
    sys.stdout.write(json.dumps({"context": context}, sort_keys=True, separators=(",", ":")) + "\n")
    return 0


def cmd_discover(args: argparse.Namespace) -> int:
    block = None
    try:
        import _storyboard_discovery
        block = _storyboard_discovery.discover(args.cwd or os.getcwd(), session_id=None,
                                               event="SessionStart", use_cache=False)
    except Exception:
        block = None
    if args.json:
        sys.stdout.write(json.dumps({"block": block}) + "\n")
    elif block:
        sys.stdout.write(block + "\n")
    sys.stdout.flush()
    return 0


def state_path(storyboard_id: str) -> Path:
    home = Path(os.environ.get("HOME") or str(Path.home()))
    return home / ".claude" / "cardinal" / "investigation-state" / f"{storyboard_id}.json"


def storyboard_for_state(storyboard_id: str, from_get):
    from cardinal_core import investigation_state as ist
    if from_get:
        return ist.load_get(from_get, lambda p: Path(p).read_text())
    import _storyboard_discovery
    return ist.fetch_storyboard(_storyboard_discovery.connection(), storyboard_id,
                                client=_storyboard_discovery.client_header())


def _oracle_sessions(got: dict, investigation) -> list:
    """The sessions whose transcripts verify a state's quotes: the
    storyboard's acts, plus, for an investigation-bound state, the session
    the investigation was created in (never the session running this CLI)."""
    sids = [act.get("session_id") for act in got.get("acts") or [] if isinstance(act, dict)]
    if isinstance(investigation, dict):
        sids.append(investigation.get("session_id"))
    from cardinal_core.investigation_state_sync import SESSION_ID_RE
    return [s for i, s in enumerate(sids) if isinstance(s, str) and SESSION_ID_RE.match(s) and s not in sids[:i]]


def _transcript(sid: str):
    home = Path(os.environ.get("HOME") or str(Path.home()))
    found = sorted((home / ".claude" / "projects").glob(f"*/{sid}.jsonl"))
    return str(found[0]) if found else None


def sessions_for_state(got: dict, extra: list, investigation=None):
    """The transcripts this machine holds for the oracle sessions
    (_oracle_sessions) and every --session, as {session_id: utterances};
    None when there are none."""
    from cardinal_core import investigation_state as ist
    paths = {}
    for sid in _oracle_sessions(got, investigation):
        found = _transcript(sid)
        if found:
            paths[sid] = found
    for f in extra or []:
        paths[Path(f).stem] = f
    if not paths:
        return None
    return ist.load_sessions(paths, lambda p: open(p, encoding="utf-8", errors="replace"))


def _oracle_note(inv_id, investigation, got: dict, extra: list) -> None:
    """Say on stderr when an investigation-bound state has no oracle for its
    quotes, or one whose transcript is not on this machine."""
    if not inv_id or not isinstance(investigation, dict) or extra:
        return
    sid = investigation.get("session_id")
    if not sid:
        if not any(isinstance(a, dict) and a.get("session_id") for a in got.get("acts") or []):
            sys.stderr.write(f"note: investigation {inv_id} records no session, so no transcript can verify a quote: "
                             "record what rests on the owner's words as agent_interpretation / unknown, or pass "
                             "--session <file> (the transcript JSONL where it was said)\n")
    elif not _transcript(sid):
        sys.stderr.write(f"note: the transcript of session {sid}, where investigation {inv_id} was created, is not on "
                         "this machine: pass --session <file> to verify quotes from it\n")


def _connection():
    import _storyboard_discovery
    return _storyboard_discovery.connection(), _storyboard_discovery.client_header()


def _refused(e, what: str) -> str:
    """A server refusal of an investigation request, in words."""
    from cardinal_core import investigation_state_sync as sync
    if sync.investigations_unsupported(e):
        return sync.INVESTIGATIONS_UNSUPPORTED
    return f"{what}: {sync.plain(e)}"


def _investigation_got(inv: dict, from_get):
    """What a state of this investigation is checked against: its storyboard,
    or a virtual empty one while none is attached."""
    from cardinal_core import investigation_state as ist
    sb = inv.get("storyboard_id")
    if not sb:
        return ist.virtual_storyboard(inv)
    got = storyboard_for_state(sb, from_get)
    if got.get("storyboard_id") != sb:
        raise ist.FetchError("the storyboard__get result is for another storyboard than the investigation's")
    return got


class _Unbound(Exception):
    pass


def got_for_state(path: str, state, from_get):
    """(got, investigation_id or None, investigation or None) for a state
    file: the investigation its PATH.server names, else the storyboard in its
    source (plugin 0.40.0). Raises FetchError, ServerError or _Unbound."""
    from cardinal_core import investigation_state as ist
    meta = _server_meta(path)
    inv_id = meta.get("investigation_id")
    if not inv_id:
        sid = ((state.get("source") or {}).get("storyboard_id") if isinstance(state, dict) else None) or ""
        if not sid and not from_get:
            raise _Unbound(f"{path} belongs to no storyboard and no investigation: `state init --investigation ID` "
                           "or `state pull --investigation ID` writes one that does")
        return storyboard_for_state(sid, from_get), None, None
    from cardinal_core import investigation_state_sync as sync
    conn, client = _connection()
    if conn.get("origin") and (meta.get("origin"), meta.get("org")) != (conn.get("origin"), conn.get("org")):
        raise _Unbound(f"{path} belongs to investigation {inv_id} on another Cardinal connection ({meta.get('origin')}): "
                       "connect to it, or pull the state from this one")
    inv = sync.get_investigation(conn, inv_id, client=client)
    got = _investigation_got(inv, from_get)
    src = state.get("source") if isinstance(state, dict) and isinstance(state.get("source"), dict) else {}
    if src.get("storyboard_id") and got.get("storyboard_id") is None:
        sys.stderr.write(f"note: {path} reflects storyboard {src['storyboard_id']}, which is no longer attached to "
                         f"investigation {inv_id} (deleted?): `cardinal-storyboard state init --investigation {inv_id} "
                         f"--refresh --out {path}` re-projects it from the investigation, keeping what is authored\n")
    return got, inv_id, inv


def _load_state(path: str):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError) as e:
        sys.stderr.write(f"{path}: {e}\n")
        return None


def _resolve(args, state):
    """got_for_state with every failure printed; (got, investigation_id, investigation) or None."""
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    try:
        return got_for_state(args.path, state, getattr(args, "from_get", None))
    except sync.ServerError as e:
        sys.stderr.write(_refused(e, "cannot read the investigation") + "\n")
    except (_Unbound, ist.FetchError, OSError, ValueError) as e:
        sys.stderr.write(f"{e}\n")
    return None


def cmd_state_init(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    if bool(args.storyboard_id) == bool(args.investigation):
        sys.stderr.write("state init takes a storyboard id or --investigation ID (one of them)\n")
        return EXIT_USAGE
    if args.investigation:
        return _init_investigation(args)
    out = Path(args.out) if args.out else state_path(args.storyboard_id)
    if out.exists() and not (args.force or args.refresh):
        sys.stderr.write(f"{out} exists: --refresh re-projects it keeping what is authored; --force starts over\n")
        return 1
    try:
        got = storyboard_for_state(args.storyboard_id, args.from_get)
    except (ist.FetchError, OSError, ValueError) as e:
        sys.stderr.write(f"{e}\n")
        return 1
    if got.get("storyboard_id") != args.storyboard_id:
        sys.stderr.write("the storyboard__get result is for another storyboard\n")
        return 1
    if args.refresh and out.exists():
        try:
            state = ist.refresh(json.loads(out.read_text()), got)
        except (OSError,) + ist.MALFORMED as e:
            sys.stderr.write(f"{out}: {e}\n")
            return 1
    else:
        state = ist.project(got)
    if not state["source"]["acts"]:
        sys.stderr.write("no published act yet: publish first, then write the state\n")
        return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    result = ist.check(state, got, sessions_for_state(got, args.session))
    sys.stdout.write(f"{out}\n{ist.summary(result)}\n\n{ist.AUTHORING_GUIDE}")
    return 0


def _init_investigation(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    inv_id = args.investigation
    out = Path(args.out) if args.out else state_path(inv_id)
    if out.exists() and not (args.force or args.refresh):
        sys.stderr.write(f"{out} exists: --refresh re-projects it keeping what is authored; --force starts over\n")
        return 1
    conn, client = _connection()
    try:
        inv = sync.get_investigation(conn, inv_id, client=client)
        got = _investigation_got(inv, args.from_get)
    except sync.ServerError as e:
        sys.stderr.write(_refused(e, f"cannot read investigation {inv_id}") + "\n")
        return 1
    except (ist.FetchError, OSError, ValueError) as e:
        sys.stderr.write(f"{e}\n")
        return 1
    sb = got.get("storyboard_id")
    meta = _server_meta(str(out))
    detached = None
    if args.refresh and out.exists():
        try:
            old = json.loads(out.read_text())
            old_sb = (old.get("source") or {}).get("storyboard_id")
            # The storyboard this investigation-bound file reflects is gone
            # from the investigation (deleted: there is no detach): re-project
            # from the investigation itself, keeping what is authored.
            gone = (sb is None and old_sb is not None and meta.get("investigation_id") == inv_id
                    and meta.get("storyboard_id") == old_sb)
            if old_sb is not None and old_sb != sb and not gone:
                sys.stderr.write(f"{out} reflects storyboard {old_sb}, and investigation {inv_id} has "
                                 f"{sb or 'no storyboard'}: --force starts over\n")
                return 1
            if gone:
                # Its open questions stay open, now the investigation's own.
                for q in old.get("open_questions") or []:
                    if isinstance(q, dict):
                        q.pop("finding", None)
            state = ist.refresh(old, got)
            detached = old_sb if gone else None
        except (OSError,) + ist.MALFORMED as e:
            sys.stderr.write(f"{out}: {e}\n")
            return 1
    else:
        state = ist.project(got)
    if sb and not state["source"]["acts"]:
        sys.stderr.write(f"storyboard {sb} has no published act yet: publish first, then write the state\n")
        return 1
    # The binding: this file is the investigation's. A server version this
    # file was already based on is kept (a refresh after attach publishes on
    # top of it); otherwise 0, and a publish over an existing server copy is
    # refused until it is pulled.
    same = (meta.get("origin"), meta.get("org")) == (conn.get("origin"), conn.get("org")) and (
        meta.get("investigation_id") == inv_id or (not meta.get("investigation_id") and sb and meta.get("storyboard_id") == sb))
    version = meta.get("version") if same and isinstance(meta.get("version"), int) else 0
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    _write_meta(out, conn, investigation_id=inv_id, storyboard_id=sb, version=version,
                etag=meta.get("etag") if version else None, session_id=inv.get("session_id"))
    _oracle_note(inv_id, inv, got, args.session)
    result = ist.check(state, got, sessions_for_state(got, args.session, inv))
    note = ""
    if detached:
        note += (f"note: storyboard {detached} is no longer attached to {inv_id} (deleted?): re-projected from the "
                 "investigation. Its findings, receipts and what was authored on them (limits, discrepancies, "
                 "receipt descriptions) are gone; state check names every item that still cites them.\n")
    server = inv.get("state") if isinstance(inv.get("state"), dict) else None
    if server and server.get("version") != version:
        note = (f"note: investigation {inv_id} already has a published state (version {server.get('version')}); "
                f"to continue from it: cardinal-storyboard state pull --investigation {inv_id}\n")
    sys.stdout.write(f"{out}\n{ist.summary(result)}\n{note}\n{ist.AUTHORING_GUIDE}")
    return 0


def cmd_state_check(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    state = _load_state(args.path)
    if state is None:
        return 1
    resolved = _resolve(args, state)
    if resolved is None:
        return 1
    got, inv_id, inv = resolved
    _oracle_note(inv_id, inv, got, args.session)
    sessions = sessions_for_state(got, args.session, inv)
    if args.downgrade:
        state, changes = ist.downgrade(state, sessions)
        Path(args.path).write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
        for c in changes:
            sys.stdout.write(f"downgraded: {c}\n")
    # The last state that checked ok: its authored items may not disappear.
    snapshot = Path(args.path + ".last-ok")
    previous = None
    if snapshot.exists():
        try:
            previous = json.loads(snapshot.read_text())
        except (OSError, ValueError):
            previous = None
    result = ist.check(state, got, sessions, previous, tuple(args.allow_remove))
    for e in result["errors"]:
        sys.stdout.write(f"error: {e}\n")
    for w in result["warnings"]:
        sys.stdout.write(f"warning: {w}\n")
    sys.stdout.write(("ok: " if not result["errors"] else "") + ist.summary(result) + "\n")
    if result["errors"]:
        return 1
    snapshot.write_text(json.dumps(state, ensure_ascii=False) + "\n")
    return 0


def _server_meta(path: str) -> dict:
    try:
        meta = json.loads(Path(path + ".server").read_text())
    except (OSError, ValueError):
        return {}
    return meta if isinstance(meta, dict) else {}


def _write_meta(path: Path, conn: dict, *, storyboard_id, version: int, etag, investigation_id=None,
                session_id=None) -> None:
    """PATH.server: where the canonical copy lives and which version this file
    is based on. A storyboard-bound state's sidecar is exactly plugin 0.40.0's
    {origin, org, storyboard_id, version, etag}; an investigation-bound one
    adds investigation_id and session_id (the session it was created in,
    whose transcript verifies its quotes; null when it records none), and
    storyboard_id is null before a storyboard."""
    meta = {"origin": conn.get("origin"), "org": conn.get("org")}
    if investigation_id:
        meta.update(investigation_id=investigation_id, session_id=session_id)
    meta.update(storyboard_id=storyboard_id, version=version, etag=etag)
    Path(str(path) + ".server").write_text(json.dumps(meta) + "\n")


def _write_server_copy(path: Path, conn: dict, got: dict, state: dict, investigation_id=None,
                       session_id=None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    _write_meta(path, conn, investigation_id=investigation_id, storyboard_id=got.get("storyboard_id"),
                version=got["version"], etag=got["etag"], session_id=session_id)
    Path(str(path) + ".last-ok").write_text(json.dumps(state, ensure_ascii=False) + "\n")


def cmd_state_publish(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    import _storyboard_discovery
    state = _load_state(args.path)
    if state is None:
        return 1
    sid = ((state.get("source") or {}).get("storyboard_id") if isinstance(state, dict) else None) or ""
    conn = _storyboard_discovery.connection()
    resolved = _resolve(args, state)
    if resolved is None:
        return 1
    got, inv_id, inv = resolved
    _oracle_note(inv_id, inv, got, args.session)
    sessions = sessions_for_state(got, args.session, inv)
    meta = _server_meta(args.path)
    if inv_id:
        # got_for_state refused a sidecar of another connection.
        base = meta.get("version") if isinstance(meta.get("version"), int) else 0
        pull = f"cardinal-storyboard state pull --investigation {inv_id}"
    else:
        same_server = (meta.get("origin"), meta.get("org"), meta.get("storyboard_id")) == (conn.get("origin"), conn.get("org"), sid)
        base = meta.get("version") if same_server and isinstance(meta.get("version"), int) else 0
        pull = f"cardinal-storyboard state pull {sid}"
    # Check here first: nothing that fails locally is sent.
    previous = None
    snapshot = Path(args.path + ".last-ok")
    if snapshot.exists():
        try:
            previous = json.loads(snapshot.read_text())
        except (OSError, ValueError):
            previous = None
    result = ist.check(state, got, sessions, previous, tuple(args.allow_remove))
    if result["errors"]:
        for e in result["errors"]:
            sys.stdout.write(f"error: {e}\n")
        sys.stdout.write("not published: fix the errors (state check) first\n")
        return 1
    attestation = sync.attest(state, sessions)
    try:
        out = sync.put_state(conn, state, base_version=base, attestation=attestation,
                             allow_removed=args.allow_remove, client=_storyboard_discovery.client_header(),
                             investigation_id=inv_id)
    except sync.ServerError as e:
        body = e.body
        if inv_id and sync.investigations_unsupported(e):
            sys.stdout.write(f"not published: {sync.INVESTIGATIONS_UNSUPPORTED} ({args.path}).\n")
        elif sync.unsupported(e):
            sys.stdout.write(f"not published: {sync.UNSUPPORTED} ({args.path}).\n")
        elif body.get("error") == "version_conflict":
            sys.stdout.write(f"not published: the server copy is at version {body.get('current_version')} and this file is "
                             f"based on version {base}. The server copy is canonical: `{pull}` "
                             "(to another --out if you have edits), re-apply the edits to it, and publish again.\n")
        elif body.get("error") == "invalid_state":
            for x in body.get("errors") or []:
                sys.stdout.write(f"server error: {x}\n")
            sys.stdout.write("not published: the server refused the state\n")
        elif inv_id:
            sys.stdout.write(f"not published: {sync.plain(e)}\n")
        else:
            sys.stdout.write(f"not published: {e}\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"{e}\n")
        return 1
    answered_for = (out.get("investigation_id", inv_id) == inv_id) if inv_id else out.get("storyboard_id") == sid
    if not answered_for or not sync.server_copy_ok(out):
        sys.stderr.write(f"put-state answered for another {'investigation' if inv_id else 'storyboard'} "
                         "or without a version and etag\n")
        return 1
    if inv_id:
        out = dict(out, storyboard_id=got.get("storyboard_id"))
    _write_server_copy(Path(args.path), conn, out, state, investigation_id=inv_id,
                       session_id=(inv or {}).get("session_id"))
    trust = out.get("trust") or {}
    attested = trust.get("client_attested_authority") or []
    sys.stdout.write(f"published: version {out['version']} (etag {out['etag'][:12]}…){' unchanged' if out.get('unchanged') else ''}; "
                     f"{len(attestation['quotes'])} quotes and {len(attestation['plan_approvals'])} plan approvals attested; "
                     f"{len(attested)} authority claims rest on them (marked client-attested on the server); "
                     f"{len(out.get('warnings') or [])} warnings\n"
                     "The server copy is now canonical: later edits are based on it (state pull to refetch).\n")
    return 0


def cmd_state_pull(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    if bool(args.storyboard_id) == bool(args.investigation):
        sys.stderr.write("state pull takes a storyboard id or --investigation ID (one of them)\n")
        return EXIT_USAGE
    inv_id = args.investigation
    out = Path(args.out) if args.out else state_path(inv_id or args.storyboard_id)
    conn, client = _connection()
    try:
        if inv_id:
            # get-investigation first: a server without investigations says so
            # plainly, and an investigation with no state yet is not an error code.
            inv = sync.get_investigation(conn, inv_id, client=client)
            if not inv.get("state"):
                sys.stderr.write(f"investigation {inv_id} has no published InvestigationState yet: "
                                 f"`cardinal-storyboard state init --investigation {inv_id}` writes one\n")
                return 1
            got = sync.get_state(conn, investigation_id=inv_id, client=client)
        else:
            got = sync.get_state(conn, args.storyboard_id, client=client)
    except sync.ServerError as e:
        if inv_id:
            sys.stderr.write(_refused(e, f"cannot pull investigation {inv_id}") + "\n")
        else:
            sys.stderr.write((sync.UNSUPPORTED if sync.unsupported(e) else str(e)) + "\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"{e}\n")
        return 1
    if not sync.server_copy_ok(got):
        sys.stderr.write("get-state answered without a version and etag\n")
        return 1
    state = got["state"]
    if out.exists() and not args.force:
        try:
            local = json.loads(out.read_text())
        except (OSError, ValueError):
            local = None
        if local != state:
            sys.stderr.write(f"{out} differs from the server copy (version {got['version']}): publish its edits, pull to "
                             "another --out, or --force to replace it with the server copy\n")
            return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    if inv_id:
        # The storyboard the state reflects (null before one), not the one attached since.
        src = state.get("source") if isinstance(state.get("source"), dict) else {}
        got = dict(got, storyboard_id=src.get("storyboard_id"))
    _write_server_copy(out, conn, got, state, investigation_id=inv_id,
                       session_id=inv.get("session_id") if inv_id else None)
    trust = got.get("trust") or {}
    sys.stdout.write(f"{out}\nversion {got['version']}; "
                     f"{'current' if got.get('current') else 'STALE: ' + str(got.get('stale_note'))}; "
                     f"{len(trust.get('client_attested_authority') or [])} authority claims are client-attested\n")
    return 0


def cmd_investigation_create(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    window = None
    if args.window is not None:
        try:
            window = json.loads(args.window)
        except ValueError as e:
            sys.stderr.write(f"--window is not JSON: {e}\n")
            return EXIT_USAGE
    # The session it is created in: before any storyboard, the only
    # transcript that may verify the state's quotes.
    session_id = os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_SESSION_ID") or None
    conn, client = _connection()
    try:
        out = sync.create_investigation(conn, args.question, window, client=client, session_id=session_id)
    except sync.ServerError as e:
        sys.stderr.write(_refused(e, "investigation not created") + "\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"{e}\n")
        return 1
    inv_id = out["investigation_id"]
    sys.stdout.write(f"{inv_id}\n")
    if session_id:
        try:
            from cardinal_core import investigation_events as ie
            ie.bind(_home(), session_id, inv_id, "create")
            sys.stderr.write(f"bound session {session_id} to it: advisory events reach it at its next tool boundary\n")
        except (OSError, ValueError) as e:
            sys.stderr.write(f"note: session {session_id} not bound to it ({e})\n")
    sys.stderr.write(f"next: cardinal-storyboard state init --investigation {inv_id}\n")
    return 0


def cmd_investigation_attach(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    conn, client = _connection()
    try:
        out = sync.attach_storyboard(conn, args.investigation_id, args.storyboard_id, client=client)
    except sync.ServerError as e:
        sys.stderr.write(_refused(e, "not attached") + "\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"{e}\n")
        return 1
    sys.stdout.write(f"attached {args.storyboard_id} to {args.investigation_id}. The state's next publish must reflect "
                     f"it: cardinal-storyboard state init --investigation {args.investigation_id} --refresh "
                     "[--out PATH] keeps everything authored.\n")
    if isinstance(out.get("note"), str) and out["note"]:
        sys.stdout.write(f"Cardinal: {out['note']}\n")
    return 0


def cmd_investigation_show(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    conn, client = _connection()
    try:
        inv = sync.get_investigation(conn, args.investigation_id, client=client)
    except sync.ServerError as e:
        sys.stderr.write(_refused(e, f"cannot read investigation {args.investigation_id}") + "\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"{e}\n")
        return 1
    sys.stdout.write(json.dumps(inv, indent=2, ensure_ascii=False) + "\n")
    return 0


def _home() -> Path:
    return Path(os.environ.get("HOME") or str(Path.home()))


def _session_arg(args: argparse.Namespace):
    """--session, else this Claude Code session; None (with a message) when neither is a session id."""
    from cardinal_core import investigation_events as ie
    sid = args.session or os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_SESSION_ID")
    if not ie.valid_session(sid):
        sys.stderr.write("needs --session SID (an agent session id: letters, digits, _ and -; at most 128)\n"
                         if not sid else f"not a session id: {sid!r}\n")
        return None
    return sid


def _investigation_arg(inv_id: str) -> bool:
    from cardinal_core import investigation_events as ie
    if ie.valid_investigation(inv_id):
        return True
    sys.stderr.write(f"not an investigation id: {inv_id!r} (inv_ followed by 24 hex characters)\n")
    return False


def cmd_investigation_bind(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_events as ie
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    sid = _session_arg(args)
    if not sid or not _investigation_arg(args.investigation_id):
        return EXIT_USAGE
    conn, client = _connection()
    try:  # the events route answers for this investigation (and exists on this server)
        ie.read_events(conn, args.investigation_id, after=0, limit=1, to_session_id=sid, client=client)
    except sync.ServerError as e:
        sys.stderr.write(f"not bound: {ie.plain(e)}\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"note: could not reach Cardinal to check the investigation ({e}); binding anyway\n")
    try:
        binding, created = ie.bind(_home(), sid, args.investigation_id, "cli")
    except (OSError, ValueError) as e:
        sys.stderr.write(f"not bound: {e}\n")
        return 1
    sys.stdout.write(f"{'bound' if created else 'already bound'}: session {sid} -> {args.investigation_id} "
                     f"(cursor {binding['cursor']}). Advisory events reach it at its next tool boundary.\n")
    return 0


def cmd_investigation_ack(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_events as ie
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    sid = _session_arg(args)
    if not sid or not _investigation_arg(args.investigation_id):
        return EXIT_USAGE
    conn, client = _connection()
    try:
        payload = ie.ack_payload(args.seq, args.disposition, args.note)
        out = ie.append_event(conn, args.investigation_id, ie.ACKNOWLEDGED, payload,
                              idempotency_key=ie.ack_key(sid, args.seq), session_id=sid, client=client,
                              producer_client=plugin_client())
    except sync.ServerError as e:
        if e.body.get("error") == "idempotency_conflict":
            sys.stderr.write(f"event #{args.seq} was already acknowledged from session {sid} with another "
                             "disposition or note; an acknowledgment is final\n")
        else:
            sys.stderr.write(f"not acknowledged: {ie.plain(e)}\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"not acknowledged: {e}\n")
        return 1
    ev = out["event"]
    if out.get("duplicate"):
        sys.stdout.write(f"event #{args.seq} was already acknowledged ({args.disposition}) as event #{ev['seq']}\n")
    else:
        sys.stdout.write(f"acknowledged event #{args.seq} ({args.disposition}) as event #{ev['seq']}\n")
    return 0


def _print_link(b: dict, as_json: bool) -> None:
    from cardinal_core import investigation_bootstrap as boot
    f = boot.describe(b)
    if as_json:
        sys.stdout.write(json.dumps({k: f[k] for k in ("investigation_id", "storyboard_id", "view_url",
                                                       "investigation_url", "is_author")}, indent=2) + "\n")
        return
    if f["view_url"]:
        sys.stdout.write(f"Storyboard (live, private to org members): {f['view_url']}\n")
    if f["investigation_url"]:
        sys.stdout.write(f"Investigation (control log): {f['investigation_url']}\n")
    sys.stdout.write(f"investigation {f['investigation_id']}"
                     + (f" · storyboard {f['storyboard_id']}" if f["storyboard_id"] else " · no storyboard attached")
                     + ("" if f["is_author"] else " · joined: someone else's investigation (not the author)")
                     + "\n")


def cmd_investigation_link(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_bootstrap as boot
    from cardinal_core import investigation_events as ie
    sid = _session_arg(args)
    if not sid:
        return EXIT_USAGE
    home = _home()
    b = ie.read_binding(home, sid)
    ok = b is not None and isinstance(b.get("bootstrap"), dict) and b["bootstrap"].get("status") == "ok"
    if not ok or (b.get("storyboard_id") and not b.get("view_url")):
        conn, client = _connection()
        res = boot.ensure(home, sid, conn, client, timeout=15.0, force=True)
        b = res.get("binding") or b
        if res["status"] == "invalid":
            sys.stderr.write("not connected to Cardinal (run /cardinal:connect)\n")
            if not b:
                return 1
        elif res["status"] == "unsupported":
            sys.stderr.write("this Cardinal server does not create session investigations yet (it needs a newer "
                             "Maestro)\n")
            if not b:
                return 1
        elif res["status"] in ("failed", "busy") and not (b and b.get("view_url")):
            sys.stderr.write(f"Cardinal could not set up this session's investigation: "
                             f"{res.get('error') or 'another process is doing it; try again in a moment'}\n")
            if not b:
                return 1
        else:
            try:  # the session's poller (not running when its first attempt failed)
                import subprocess
                from cardinal_core import investigation_poller as ip
                if os.environ.get("CARDINAL_INVESTIGATION_POLLER", "").strip() != "0" and not ip.running(home, sid):
                    subprocess.Popen([sys.executable, str(PLUGIN_ROOT / "hooks" / "investigation-poller.py"),
                                      "--session", sid, "--anchor", str(os.getppid())],
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     close_fds=True, start_new_session=True)
            except Exception:
                pass
    _print_link(b, args.json)
    return 0


def cmd_investigation_question(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_events as ie
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    inv_id = args.investigation
    if inv_id is None:
        sid = _session_arg(args)
        if not sid:
            return EXIT_USAGE
        b = ie.read_binding(_home(), sid)
        if not b:
            sys.stderr.write(f"session {sid} has no investigation yet: run `cardinal-storyboard investigation link`, "
                             "or pass --investigation ID\n")
            return 1
        inv_id = b["investigation_id"]
    elif not _investigation_arg(inv_id):
        return EXIT_USAGE
    own = os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_SESSION_ID")
    sid = getattr(args, "session", None) or own
    if not args.text.strip() or len(args.text) > sync.MAX_INVESTIGATION_QUESTION:
        sys.stderr.write(f"question not set: the question is 1 to {sync.MAX_INVESTIGATION_QUESTION} characters "
                         f"(this one has {len(args.text)})\n")
        return EXIT_USAGE
    conn, client = _connection()
    try:
        out = sync.set_investigation_question(conn, inv_id, args.text, client=client,
                                              session_id=sid if ie.valid_session(sid) else None)
    except sync.ServerError as e:
        sys.stderr.write(_refused(e, "question not set") + "\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"question not set: {e}\n")
        return 1
    sys.stdout.write(f"investigation {inv_id} now asks: {ie.json_text(args.text)}\n")
    if isinstance(out.get("note"), str) and out["note"]:
        sys.stdout.write(f"Cardinal: {ie.json_text(out['note'])}\n")
    return 0


def _event_line(e: dict) -> str:
    from cardinal_core import investigation_events as ie
    p = e.get("producer") if isinstance(e.get("producer"), dict) else {}
    pr = p.get("principal") if isinstance(p.get("principal"), dict) else {}
    who = f"{ie._tok(pr.get('kind'))}:{ie._tok(pr.get('id'))}"
    if p.get("session_id"):
        who += f" claimed session {ie._claimed(p['session_id'])}"
    if p.get("is_investigation_author") is True:
        who += " (author)"
    to = f" to session {ie._tok(e['to_session_id'])}" if e.get("to_session_id") else ""
    payload = e.get("payload") if isinstance(e.get("payload"), dict) else {}
    if e.get("type") in ie.SEMANTIC_TYPES:
        # A producer claim (the server stamps authority producer_claim):
        # its id, then its text as JSON strings, never a bare line.
        ident, body = ie.semantic_body(e)
        return (f"#{e.get('seq')} {ie._tok(e.get('created_at'))} {e['type']} {ident} from {who}{to}"
                + (f": {body}" if body else ""))
    if e.get("type") == ie.ACKNOWLEDGED:
        body = f"ack of #{payload.get('ack_of')}: {ie._tok(payload.get('disposition'))}"
        if isinstance(payload.get("note"), str):
            body += f" {ie.json_text(payload['note'])}"
    else:
        body = ie.json_text(str(payload.get("text", "")))
    return f"#{e.get('seq')} {ie._tok(e.get('created_at'))} {ie._tok(e.get('type'))} from {who}{to}: {body}"


def cmd_investigation_events(args: argparse.Namespace) -> int:
    from cardinal_core import investigation_events as ie
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    if not _investigation_arg(args.investigation_id):
        return EXIT_USAGE
    if args.after < 0:
        sys.stderr.write("--after is a seq, 0 or more\n")
        return EXIT_USAGE
    conn, client = _connection()
    try:
        events, cursor, head = ie.read_all(conn, args.investigation_id, after=args.after, client=client,
                                           max_pages=1000, timeout=30.0, limit=ie.CLI_PAGE_LIMIT)
    except sync.ServerError as e:
        sys.stderr.write(f"cannot read the events of {args.investigation_id}: {ie.plain(e)}\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"{e}\n")
        return 1
    if args.json:
        sys.stdout.write(json.dumps({"investigation_id": args.investigation_id, "events": events,
                                     "next_after": cursor, "head_seq": head}, indent=2, ensure_ascii=False) + "\n")
        return 0
    for e in events:
        sys.stdout.write(_event_line(e) + "\n")
    sys.stderr.write(f"{len(events)} event{'s' if len(events) != 1 else ''} after #{args.after}; head #{head}\n")
    return 0


def cmd_investigation_post(args: argparse.Namespace) -> int:
    import secrets
    from cardinal_core import investigation_events as ie
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    if not _investigation_arg(args.investigation_id):
        return EXIT_USAGE
    key = args.idempotency_key or f"post:{secrets.token_hex(16)}"
    own = os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_SESSION_ID")
    conn, client = _connection()
    try:
        payload = ie.text_payload(args.text, args.ref or None)
        out = ie.append_event(conn, args.investigation_id, ie.POST_TYPES[args.type], payload, idempotency_key=key,
                              to_session_id=args.to_session, session_id=own if ie.valid_session(own) else None,
                              client=client, producer_client=plugin_client())
    except sync.ServerError as e:
        sys.stderr.write(f"not posted: {ie.plain(e)}\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"not posted: {e}\n")
        return 1
    ev = out["event"]
    sys.stdout.write(f"{'already posted' if out.get('duplicate') else 'posted'}: event #{ev['seq']} "
                     f"({ev.get('type')}, idempotency key {key})\n")
    return 0


CHECKPOINT_TIMING_ENV = "CARDINAL_CHECKPOINT_TIMING"

CHECKPOINT_HELP = """\
A JSON array of 1-20 events on stdin, appended to this session's Investigation atomically.
Each {"type", "id", ...fields} is your claim (not a fact), never reasoning. required; optional:
  hypothesis.proposed   hyp_*       statement; evidence, refs
  hypothesis.resolved   hyp_*       outcome supported|contradicted|inconclusive; statement, evidence, refs
  experiment.started    exp_*       statement; tests [hyp_*], refs
  experiment.completed  exp_*       outcome; evidence, refs
  finding.proposed      finding_*   statement; evidence, refs
  finding.revised       finding_*   statement; evidence, refs
  finding.retracted     finding_*   reason; evidence, refs
  decision.proposed     decision_*  statement; based_on [finding_*|hyp_*|exp_*], evidence, refs
  decision.revised      decision_*  statement; based_on, evidence, refs
  question.opened       question_*  statement; refs
  question.resolved     question_*  answer; evidence, refs
evidence: rcpt_ / ev_ ids (a cited ev_ is uploaded as an Investigation receipt first).
refs: earlier ids or "#<seq>". An id stays the same in its later events. Text <= 2000 chars."""


def cmd_investigation_checkpoint(args: argparse.Namespace) -> int:
    import time
    t0 = time.monotonic()
    timing = {"upload": 0.0}
    try:
        return _checkpoint(args, timing)
    finally:
        if os.environ.get(CHECKPOINT_TIMING_ENV) == "1":
            ms = {k: round(v * 1000) for k, v in (("total", time.monotonic() - t0), ("upload", timing["upload"]),
                                                  ("request", timing.get("request", 0.0)))}
            sys.stderr.write(f"checkpoint timing: total {ms['total']} ms, upload {ms['upload']} ms, request "
                             f"{ms['request']} ms, events {timing.get('events', 0)}\n")


def _checkpoint(args: argparse.Namespace, timing: dict) -> int:
    import time
    from cardinal_core import investigation_events as ie
    from cardinal_core import investigation_state as ist
    from cardinal_core import investigation_state_sync as sync
    sid = _session_arg(args)
    if not sid:
        return EXIT_USAGE
    b = ie.read_binding(_home(), sid)
    if not b:
        sys.stderr.write(f"not checkpointed: session {sid} has no investigation (not connected, or its setup failed: "
                         "`cardinal-storyboard investigation link` retries it)\n")
        return EXIT_USAGE
    if b.get("is_author") is False:
        sys.stderr.write(f"not checkpointed: session {sid} joined someone else's investigation; only its author's "
                         "session records checkpoints (post a cue, question or challenge instead)\n")
        return EXIT_USAGE
    if args.key is not None and not ie.CHECKPOINT_KEY_RE.fullmatch(args.key):
        sys.stderr.write("not checkpointed: --key is 1-100 characters of A-Z a-z 0-9 . _ : -\n")
        return EXIT_USAGE
    if sys.stdin.isatty():
        sys.stderr.write("not checkpointed: pipe a JSON array of events on stdin (--help lists the types)\n")
        return EXIT_USAGE
    try:
        data = json.loads(sys.stdin.read())
    except ValueError as e:
        sys.stderr.write(f"not checkpointed: stdin is not JSON ({e})\n")
        return EXIT_USAGE
    conn, client = _connection()
    t = time.monotonic()
    try:
        out = ie.checkpoint(conn, b["investigation_id"], sid, data, idempotency_key=args.key, client=client,
                            producer_client=plugin_client(), timing=timing)
    except ie.CheckpointInputError as e:
        sys.stderr.write(f"not checkpointed: {e}\n")
        return EXIT_USAGE
    except ie.EvidenceRefused as e:
        if e.code == "evidence_unsupported":
            sys.stderr.write(f"{e}\n")
            return EXIT_USAGE
        sys.stderr.write(f"not checkpointed (cited evidence): {e}\n")
        return EXIT_USAGE if e.code == "evidence_not_citable" else 1
    except sync.ServerError as e:
        if ie.checkpoint_unsupported(e):
            sys.stderr.write(ie.CHECKPOINT_UNSUPPORTED + "\n")
            return EXIT_USAGE
        sys.stderr.write(f"not checkpointed: {ie.checkpoint_refusal(e)}\n")
        return 1
    except ist.FetchError as e:
        sys.stderr.write(f"not checkpointed: {e}\n")
        return 1
    finally:
        timing["request"] = time.monotonic() - t - timing["upload"]
    timing["events"] = len(out["events"])
    if args.json:
        sys.stdout.write(json.dumps(out, indent=2, ensure_ascii=False) + "\n")
    else:
        sys.stdout.write(ie.checkpoint_line(out) + "\n")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="cardinal-storyboard",
        description="Local facts for Cardinal Investigation Storyboards.",
    )
    sub = parser.add_subparsers(dest="command", metavar="{context,discover,state,investigation}")
    context = sub.add_parser("context", help="print the context for storyboard__find / create / add_act")
    context.add_argument("--cwd", help="directory to describe (default: the current directory)")
    context.add_argument("--session-id", help="this session's id: adds the files it edited as paths")
    context.set_defaults(func=cmd_context)
    discover = sub.add_parser("discover", help="print the storyboards this PR, branch or directory already has")
    discover.add_argument("--cwd", help="directory to look from (default: the current directory)")
    discover.add_argument("--json", action="store_true", help='print {"block": <text or null>}')
    discover.set_defaults(func=cmd_discover)
    state = sub.add_parser("state", help="write or check a storyboard's InvestigationState")
    state_sub = state.add_subparsers(dest="state_command", metavar="{init,check,publish,pull}")
    init = state_sub.add_parser("init", help="project a published storyboard (or an investigation) into a new InvestigationState")
    init.add_argument("storyboard_id", nargs="?")
    init.add_argument("--investigation", metavar="ID", help="the investigation's state instead (before or after a storyboard)")
    init.add_argument("--out", help="where to write it (default ~/.claude/cardinal/investigation-state/<id>.json)")
    mode = init.add_mutually_exclusive_group()
    mode.add_argument("--refresh", action="store_true", help="re-project an existing state, keeping what is authored")
    mode.add_argument("--force", action="store_true", help="overwrite an existing state")
    init.add_argument("--from-get", help="a saved storyboard__get result instead of fetching")
    init.add_argument("--session", action="append", default=[], help="another session transcript (JSONL) to verify quotes against")
    init.set_defaults(func=cmd_state_init)
    chk = state_sub.add_parser("check", help="check an InvestigationState against its storyboard")
    chk.add_argument("path")
    chk.add_argument("--from-get", help="a saved storyboard__get result instead of fetching")
    chk.add_argument("--session", action="append", default=[], help="another session transcript (JSONL) to verify quotes against")
    chk.add_argument("--downgrade", action="store_true",
                     help="lower every authority claim its sources do not establish (rewrites the file; removes nothing)")
    chk.add_argument("--allow-remove", action="append", default=[], metavar="ID",
                     help="an item deliberately removed since the last ok check (a duplicate or a mistake)")
    chk.set_defaults(func=cmd_state_check)
    pub = state_sub.add_parser("publish", help="publish an InvestigationState to Cardinal (the server copy is canonical after)")
    pub.add_argument("path")
    pub.add_argument("--session", action="append", default=[], help="another session transcript (JSONL) to verify quotes against")
    pub.add_argument("--allow-remove", action="append", default=[], metavar="ID",
                     help="an item deliberately removed since the server copy (a duplicate or a mistake)")
    pub.set_defaults(func=cmd_state_publish)
    pull = state_sub.add_parser("pull", help="fetch a storyboard's (or an investigation's) InvestigationState from Cardinal")
    pull.add_argument("storyboard_id", nargs="?")
    pull.add_argument("--investigation", metavar="ID", help="the investigation's state instead")
    pull.add_argument("--out", help="where to write it (default ~/.claude/cardinal/investigation-state/<id>.json)")
    pull.add_argument("--force", action="store_true", help="replace a local file that differs from the server copy")
    pull.set_defaults(func=cmd_state_pull)
    inv = sub.add_parser("investigation", help="this session's Investigation on Cardinal (created automatically)")
    inv_sub = inv.add_subparsers(dest="investigation_command",
                                 metavar="{link,question,checkpoint,create,attach,show,bind,ack,events,post}")
    link = inv_sub.add_parser("link", help="print this session's live Storyboard and Investigation URLs")
    link.add_argument("--session", help="the session id (default $CLAUDE_CODE_SESSION_ID)")
    link.add_argument("--json", action="store_true", help="ids and URLs as JSON")
    link.set_defaults(func=cmd_investigation_link)
    question = inv_sub.add_parser("question", help="record what the investigation asks (your statement of it)")
    question.add_argument("text", help="the question (1 to 1000 characters)")
    qwho = question.add_mutually_exclusive_group()
    qwho.add_argument("--session", help="the session whose investigation (default $CLAUDE_CODE_SESSION_ID)")
    qwho.add_argument("--investigation", metavar="ID", help="an investigation id instead")
    question.set_defaults(func=cmd_investigation_question)
    ckpt = inv_sub.add_parser("checkpoint", help="record a material change in your understanding (events on stdin)",
                              description=CHECKPOINT_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    ckpt.add_argument("--session", metavar="SID", help="the session id (default $CLAUDE_CODE_SESSION_ID)")
    ckpt.add_argument("--key", metavar="K", help="idempotency key (default: derived from the content)")
    ckpt.add_argument("--json", action="store_true", help="print Cardinal's answer as JSON")
    ckpt.set_defaults(func=cmd_investigation_checkpoint)
    create = inv_sub.add_parser("create", help="optional: create a separate investigation and bind this session to it")
    create.add_argument("--question", required=True, help="what the investigation asks (at most 2000 characters)")
    create.add_argument("--window", help='its time window as JSON, e.g. {"start": "...", "end": "..."}')
    create.set_defaults(func=cmd_investigation_create)
    attach = inv_sub.add_parser("attach", help="attach a storyboard you authored an act of to your investigation")
    attach.add_argument("investigation_id")
    attach.add_argument("storyboard_id")
    attach.set_defaults(func=cmd_investigation_attach)
    show = inv_sub.add_parser("show", help="print an investigation")
    show.add_argument("investigation_id")
    show.set_defaults(func=cmd_investigation_show)
    bind = inv_sub.add_parser("bind", help="optional: bind an agent session to another existing investigation")
    bind.add_argument("investigation_id")
    bind.add_argument("--session", help="the session id (default $CLAUDE_CODE_SESSION_ID)")
    bind.set_defaults(func=cmd_investigation_bind)
    ack = inv_sub.add_parser("ack", help="acknowledge an advisory event as this session")
    ack.add_argument("investigation_id")
    ack.add_argument("seq", type=int, help="the event's number (#seq)")
    ack.add_argument("--disposition", required=True, choices=("accepted", "declined", "noted"))
    ack.add_argument("--note", help="what you will do (at most 2000 characters)")
    ack.add_argument("--session", help="the session id (default $CLAUDE_CODE_SESSION_ID)")
    ack.set_defaults(func=cmd_investigation_ack)
    events = inv_sub.add_parser("events", help="print the investigation's event stream")
    events.add_argument("investigation_id")
    events.add_argument("--after", type=int, default=0, help="only events after this seq (default 0)")
    events.add_argument("--json", action="store_true", help="the events as JSON")
    events.set_defaults(func=cmd_investigation_events)
    post = inv_sub.add_parser("post", help="append an advisory event (cue, question or challenge)")
    post.add_argument("investigation_id")
    post.add_argument("--type", required=True, choices=("cue", "question", "challenge"))
    post.add_argument("--text", required=True, help="the event's text (at most 4000 characters)")
    post.add_argument("--ref", action="append", default=[], help="a reference (repeatable, at most 10)")
    post.add_argument("--to-session", help="address one session (default: every session of the investigation)")
    post.add_argument("--idempotency-key", help="re-sending the same key and text is a no-op (default: random)")
    post.set_defaults(func=cmd_investigation_post)
    return parser


def main(argv: list | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return EXIT_USAGE
    return args.func(args)


if __name__ == "__main__":
    code = main()
    sys.stdout.flush()
    # discover may leave an abandoned request thread behind its deadline.
    os._exit(code)
